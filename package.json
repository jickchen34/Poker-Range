{
  "name": "poker_range",
  "private": true,
  "version": "0.0.0",
  "description": "A poker range application built with Vue and Electron",
  "author": "jickchen34",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite --port 5173 & wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "PokerRange",
    "files": [
      "dist/**/*",
      "src/electron/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.0.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^21.0.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^7.0.1",
    "electron": "19.1.8",
    "electron-builder": "^23.3.2"
  }
}
